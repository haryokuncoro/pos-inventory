{
  "name": "basic-login",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:desktop": "concurrently -k \"next dev --turbopack\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "build": "next build --turbopack",
    "build:desktop": "npm run build && node electron/prepare-standalone.cjs && electron-builder",
    "start:desktop": "electron .",
    "start": "next start",
    "lint": "eslint",
    "dev:local": "DB_DRIVER=pglite PGLITE_DATA_DIR=./data/pglite next dev --turbopack",
    "generate": "npx drizzle-kit generate",
    "migrate": "npx drizzle-kit migrate",
    "db:seed": "tsx db/seed-cli.ts",
    "db:seed:local": "DB_DRIVER=pglite PGLITE_DATA_DIR=./data/pglite tsx db/seed-cli.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@electric-sql/pglite": "0.5.8",
    "@hookform/resolvers": "^5.7.1",
    "@neondatabase/serverless": "^1.1.0",
    "@types/pg": "^8.21.0",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.28.0",
    "next": "15.5.22",
    "papaparse": "^5.5.4",
    "pg": "^8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.84.0",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^39.2.7",
    "electron-builder": "^26.3.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.posinventory.app",
    "productName": "POS Inventory",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "desktop-build",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
